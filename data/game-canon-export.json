  "cosmicLaws": [
    {
      "id": "law-01",
      "lawNum": 1,
      "titleAr": "الصدام المرئي (Visual Clash)",
      "titleEn": "Visual Clash",
      "descriptionAr": "تلتقي الخامات الفنية ثنائية الأبعاد (الحبر، الفحم، الألوان المائية، الورق، التطريز، والزجاج الملوّن) مع البيئة السينمائية الواقعية دون أن تذوب فيها؛ كل عنصر يحافظ على ملمسه الأصلي مع تفاعل حقيقي مع الضوء والظل.",
      "descriptionEn": "2D artistic media (ink, charcoal, watercolor, paper, embroidery, and stained-glass) meet photorealistic live-action environments without melting away; each medium retains its authentic texture while casting real light and shadow."
    },
    {
      "id": "law-02",
      "lawNum": 2,
      "titleAr": "فيزيائية الأدوات الفنية",
      "titleEn": "Physics of Art Tools",
      "descriptionAr": "الأقلام، الأوراق الشفافة، الفوانيس، الإبرة الذهبية، القوس المنشوري، والممحاة ليست مجرد ديكور خلفي — بل هي أدوات خلق ومواجهة وبوابات عبور حقيقية تحرك مسار القصة وتحدد مصير الأبطال.",
      "descriptionEn": "Fountain pens, translucent vellum, lanterns, sewing needles, prism bows, and erasers are never mere props — they are active instruments of creation, confrontation, and dimensional travel."
    },
    {
      "id": "law-03",
      "lawNum": 3,
      "titleAr": "طبيعة الصراع (بلا عنف دموي)",
      "titleEn": "Conflict Without Gore",
      "descriptionAr": "الصراع في سكتشيك بصري وخيالي خالص ضد قوى المحو، الفقدان، أو بهتان الألوان — يُعبَّر عنه بتمزق الورق، زحف ضباب الممحاة، أو تمرد الظلال، دون أي عنف دموي.",
      "descriptionEn": "Conflict in Sketchic is purely visual and imaginative against forces of erasure, loss, or fading color — expressed through torn paper, eraser mist, and rebellious shadows, with zero gore."
    }
  ],
